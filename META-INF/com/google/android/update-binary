#!/sbin/sh

umask 022
OUTFD="$2"
ZIPFILE="$3"
export OUTFD ZIPFILE

ui_print() {
  case "${OUTFD:-}" in
    ''|*[!0-9]*)
      printf '%s\n' "$1"
      ;;
    *)
      printf 'ui_print %s\nui_print\n' "$1" >&$OUTFD
      ;;
  esac
}

zcr_require_manager_installer() {
  ui_print "! 未找到可用的模块安装器（install_module 未定义）"
  ui_print "! 已查找: /data/adb/magisk/util_functions.sh"
  ui_print "!         /data/adb/*/bin/util_functions.sh"
  ui_print "! NovaAI-MCP 需要 Magisk 20.4+、KernelSU 或 APatch 的模块安装器"
  exit 1
}

# 运行时发现安装器实现，而不是枚举框架路径。
#
# 旧实现只硬编码 magisk / ksu 两条路径，于是 APatch 支持无法被证明：若 APatch
# 不暴露这两条路径之一，安装会在这里 exit 1，customize.sh 永不执行，用户只看到
# 一句"需要模块安装器"。
#
# 现在改为：在框架目录下找第一个**确实提供 install_module** 的 util_functions.sh。
# 对 KernelSU（/data/adb/ksu/bin）、APatch（/data/adb/ap/bin）以及任何把 bin 放在
# /data/adb/<name>/bin 下的 fork 都成立；先 grep 再 source，避免 source 一个
# 不提供该 API 的文件产生副作用。
ZCR_UF=""
for cand in /data/adb/magisk/util_functions.sh /data/adb/*/bin/util_functions.sh; do
  [ -r "$cand" ] || continue
  grep -q 'install_module' "$cand" 2>/dev/null || continue
  ZCR_UF="$cand"
  break
done

[ -n "$ZCR_UF" ] || zcr_require_manager_installer

. "$ZCR_UF"

command -v install_module >/dev/null 2>&1 || zcr_require_manager_installer
install_module
exit 0
